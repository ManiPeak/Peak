{
  "name": "peak",
  "version": "1.0.1",
  "private": true,
  "description": "Peak — دستیار هوش مصنوعی شخصی Local-First با حافظهٔ دائمی، صوت فارسی و پل ماینکرفت",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -p 3784",
    "build": "next build",
    "start": "next start -p 3784",
    "db:sync": "tsx scripts/sync-db.ts",
    "diagnose": "tsx scripts/diagnose.ts",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mts",
    "test:mock": "node --import tsx --test tests/*.test.ts tests/*.test.mts",
    "test:live": "PEAK_RUN_LIVE_TESTS=1 node --import tsx --test tests/*.test.ts tests/*.test.mts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:package": "node scripts/package-check.mjs",
    "electron": "electron .",
    "dist:win": "electron-builder --win --publish=never"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.1.0",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^11.7.0",
    "drizzle-orm": "^0.38.3",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "mineflayer": "^4.24.0",
    "mineflayer-collectblock": "^1.4.1",
    "mineflayer-pathfinder": "^2.4.5",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tar": "^7.5.22",
    "vazirmatn": "^33.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vosk-browser": "^0.0.8"
  }
}
